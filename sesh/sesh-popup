#!/usr/bin/env bash
# Interactive sesh session picker for `prefix + s`, launched via display-popup -E.
#
# Same UI as sesh-fzf, one less layer. sesh-fzf is invoked with tmux `run-shell`
# and then calls `fzf-tmux`, which is a bash wrapper that makes a FIFO directory,
# forks a `cat` to pump it, and issues a nested `tmux popup` of its own. Measured
# with ps mid-picker, that chain is 7 processes:
#
#   run-shell -> bash sesh-fzf -> bash (subshell) -> bash fzf-tmux
#              -> tmux popup -> bash /tmp/fzf-tmux-XXX/args -> cat fifo2
#
# Launched as `display-popup -E sesh-popup` with plain fzf it is 2: the popup's
# bash and fzf. It also drops tmux `run-shell`, which is synchronous in the tmux
# server, so the server is not blocked while the picker waits for input.
#
# Selection is acted on inside the popup ($TMUX is set there, so `sesh connect`
# reaches the right client) rather than printed for a caller to consume.
set -uo pipefail

# Closing the picker with Esc cost 115ms before this, and none of it was tmux
# repainting: fzf waits after a bare ESC to see whether more bytes follow, because
# arrow and ALT keys arrive as ESC-prefixed sequences. Proven by isolating the key
# from the action -- `--bind esc:abort` was still 115.3ms while `q:abort` was 2.2ms.
#
# ESCDELAY sets that window. Measured close medians: unset 115.3ms, 50 -> 63.8ms,
# 25 -> 38.0ms, 10 -> 22.6ms. 25 is the conventional floor; going lower risks a
# multi-byte arrow sequence arriving split across the window on a laggy link and
# being read as a bare ESC plus literal characters. Exported here rather than set
# globally so it applies to this picker only -- and it must be in THIS process's
# environment, since the popup is spawned by the tmux server, not by the client.
export ESCDELAY=25

LIST="$HOME/.local/bin/sesh-picker-list"
# Hot path only: an awk reimplementation of `$LIST --icons`, byte-identical, that
# skips a 20.7ms Python interpreter start (awk starts in 1.6ms). $LIST still serves
# every flagged source below, which needs JSON. Falls back if it is missing.
FAST="$HOME/.local/bin/sesh-picker-fast"
[ -x "$FAST" ] || FAST="$LIST --icons"

# Always-on timing, so a slow press can be diagnosed after the fact instead of
# reproduced. The stage that matters is keypress -> painted, NOT the total: the
# total includes however long the picker sat open waiting for a keystroke, which
# on a first pass at this made every normal press look like a 1-3s "slow" run.
# fzf's own start/load events are what bracket the paint; the shell stages before
# them measured rock-steady at 0.087s over 28 presses while runs still felt slow,
# which is why the interesting timestamps had to come from inside fzf.
# Off unless SESH_PICKER_TIMING=1: each ts() call forks `date` (~1.8ms measured),
# and the seven of them were 12ms of a ~100ms load. Re-enable with
#   SESH_PICKER_TIMING=1  (and the matching keypress marker in tmux.conf)
TLOG="$HOME/.cache/sesh-picker/timing.log"
if [ "${SESH_PICKER_TIMING:-0}" = "1" ]; then
  mkdir -p "${TLOG%/*}" 2>/dev/null
  ts(){ printf '%s %s\n' "$(date +%s.%N)" "$1" >> "$TLOG"; }
else
  ts(){ :; }
fi

# fzf's own start/load probes bracket the paint, but each is an execute-silent
# that forks a shell plus `date`. Only worth paying while diagnosing.
# NOTE: expanded below as ${timing_binds[@]+"${timing_binds[@]}"}. bash 4.2 (this
# host) errors on "${arr[@]}" for an EMPTY array under `set -u`; that was only
# fixed in bash 4.4. The plain form broke the picker outright whenever timing was
# off, which is the default.
timing_binds=()
if [ "${SESH_PICKER_TIMING:-0}" = "1" ]; then
  timing_binds=(
    --bind "start:execute-silent(printf '%s fzf_start\n' \"\$(date +%s.%N)\" >> $TLOG)"
    --bind "load:execute-silent(printf '%s fzf_painted\n' \"\$(date +%s.%N)\" >> $TLOG)"
  )
fi
# Keep the log from growing without bound.
[ -f "$TLOG" ] && [ "$(wc -l < "$TLOG" 2>/dev/null || echo 0)" -gt 2000 ] && \
  tail -n 500 "$TLOG" > "$TLOG.tmp" && mv "$TLOG.tmp" "$TLOG"
ts ---press
ts start

# Digit binds: empty query -> jump to row N and accept; otherwise insert the
# digit into the query. Uses fzf's COLON form (transform:CMD) -- the paren form
# transform(...) miscounts the parentheses inside pos()/put() and fails to parse.
# $FZF_QUERY is evaluated by fzf at keypress time, so it must reach fzf literally.
digit_binds=()
for n in 1 2 3 4 5 6 7 8 9; do
  digit_binds+=(--bind
    "$n:transform:[ -z \"\$FZF_QUERY\" ] && echo \"pos($n)+accept\" || echo \"put($n)\"")
done

selection=$(
  { ts list_begin; $FAST; ts list_end; } | fzf \
    --header-lines=2 \
    --layout=reverse --no-sort --ansi \
    --delimiter='\t' --with-nth=2 --nth=2 \
    --border --border-label ' sesh ' --prompt '⚡  ' \
    --bind 'tab:down,btab:up' \
    ${timing_binds[@]+"${timing_binds[@]}"} \
    "${digit_binds[@]}" \
    --bind "ctrl-a:change-prompt(⚡  )+reload($FAST)" \
    --bind "ctrl-t:change-prompt(🪟  )+reload($LIST -t)" \
    --bind "ctrl-g:change-prompt(⚙️  )+reload($LIST -c)" \
    --bind "ctrl-x:change-prompt(📁  )+reload($LIST -z)" \
    --bind "ctrl-f:change-prompt(🔎  )+reload($LIST --find)" \
    --bind "ctrl-d:execute(tmux kill-session -t {1})+change-prompt(⚡  )+reload($LIST --icons)" \
    --preview-window 'right:45%' \
    --preview "sesh preview {1}" \
  | cut -f1
)

ts fzf_exit
if [ -n "$selection" ]; then
  sesh connect "$selection"
  ts connected
fi
exit 0  # cancelling the picker (empty selection) is not an error
