#!/usr/bin/env bash
# Three-way parity guard for the picker's row output.
#
#   sesh-picker-list.bak-20260907  the ORIGINAL, asks `sesh list` -> the authority
#   sesh-picker-list               reference reimplementation (Python)
#   sesh-picker-fast               hot path (awk)
#
# The third leg is the point. An earlier version compared only the two
# reimplementations, which agreed with each other while BOTH disagreed with sesh:
# they took tmux's own session order (alphabetical) where sesh orders by last
# activity. That passed parity and shipped a visibly wrong list. Always diff
# against the sesh-backed original, not just the two rewrites.
set -uo pipefail

# The sesh-backed original is a local artifact from the rewrite; it will not exist on
# a fresh machine. When it is absent, the sesh-vs-reference leg is skipped and only
# reference-vs-fast is checked. Point SESH_PICKER_ORIG at a copy to restore that leg.
orig="${SESH_PICKER_ORIG:-$HOME/.local/bin/sesh-picker-list.bak-20260907}"
ref="$HOME/.local/bin/sesh-picker-list"
fast="$HOME/.local/bin/sesh-picker-fast"

if [ -x "$orig" ]; then
  a=$("$orig" --icons)               # no header lines
else
  a=""                               # leg skipped, see note above
fi
b=$("$ref" --icons | tail -n +3)     # drop the 2 inline header lines
c=$("$fast" | tail -n +3)

fail=0
# The original predates the NBSP name separators (SEP in sesh-picker-list), which
# fzf's search scoping needs. Map them back to spaces for this leg only, so it still
# checks row content and order; reference vs fast below stays byte-exact.
b_plain=$(printf '%s\n' "$b" | sed $'s/\xc2\xa0/ /g')
if [ -n "$a" ] && [ "$a" != "$b_plain" ]; then
  echo "PARITY BROKEN: reference (Python) vs original (sesh)"
  diff <(printf '%s\n' "$a") <(printf '%s\n' "$b_plain") | head -20
  fail=1
fi
if [ "$b" != "$c" ]; then
  echo "PARITY BROKEN: hot path (awk) vs reference (Python)"
  diff <(printf '%s\n' "$b") <(printf '%s\n' "$c") | head -20
  fail=1
fi
if [ "$fail" = 0 ]; then
  if [ -n "$a" ]; then
    echo "PARITY OK - original == reference == fast ($(printf '%s\n' "$c" | wc -l) rows)"
  else
    echo "PARITY OK - reference == fast ($(printf '%s\n' "$c" | wc -l) rows)"
    echo "  (sesh-backed original not present; set SESH_PICKER_ORIG to check that leg)"
  fi
fi
exit "$fail"
